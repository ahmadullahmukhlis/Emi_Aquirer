# Copy to your deployment secret store or environment. Do not commit .env with real credentials.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@your-domain.example
PORTAL_PUBLIC_URL=https://portal.your-domain.example
JWT_AUTH_SECRET=replace-with-the-same-32-plus-character-secret-configured-as-PORTAL_JWT_SECRET-in-gateway
